//promise - resolve
function boilWater1(callback) {
    return new Promise((resolve, reject) => {
        let waterAvailable = true;
        if (waterAvailable) {
            resolve("Boiling the water");
        }
        else {
            reject("not available");
        }
    });
}

function addTeaPowder1(callback) {
    return new Promise((resolve, reject) => {
        let teaPowderAvailable = true;
        if (teaPowderAvailable) {
            resolve("adding the tea powder");
        }
        else {
            reject("tea powder not");
        }
    });
}

function serveTheTea1() {
    return new Promise((resolve, reject) => {
        let cupAvailable = false;
        if (cupAvailable) {
            resolve("serving the tea");
        }
        else {
            reject("cup not available");
        }
    });
}
