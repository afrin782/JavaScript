function Add(a, b, callback) {
    let result1 = a + b;
    callback(result1, subtract);
}

function Multiply(result1, callback) {
    let result2 = result1 * 5;//step:2
    callback(result2);
}

function subtract(result2) {
    console.log(result2 - 3);//12 //step:3

}
