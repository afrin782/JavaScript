//Encapsulation
class User {
   #password;
   constructor(uname,pwd) {
    this.username = uname;
    this.#password = pwd;
   } 

   validateCredentials(pwd) {
    return this.#password == pwd; 
   }
}

const user = new User("John","Secret123"); //registration
console.log(user.validateCredentials("Secret123"));

//static
class UserLogin {
    static userCount = 0;
