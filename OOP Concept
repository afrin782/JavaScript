//class is a template or blueprint which can be used to create objects
class Person {    
    constructor(name,age) {
        this.name = name;        
        this.age = age;        
    }

    intro() {
        console.log("My name is " + this.name);
        console.log("My age is " + this.age);
    }
}

//new - occupy the memory storage
const student = new Person('John',15);  
student.intro();

const employee = new Person("Alice",25);
employee.intro();



class Person {    
    constructor(name,age) {
        this.name = name;        
        this.age = age;        
    }

    intro() {
        console.log("My name is " + this.name);
        console.log("My age is " + this.age);
    }
}

//Inheritance
//in inheritance , not need to create obj, we can create datas by create a class
//inherit the child class in parent class by using "extends" keyword
class Student extends Person {
    constructor(name, age, total_marks) {
       //get the contructor data from parent class by using "super" keyword 
        super(name,age);
        this.total_marks = total_marks;
    }

    showTotalMarks() {
        console.log("My Total Marks is " + this.total_marks);
    }
}

class Employee extends Person{
    constructor(name,age,salary) {
        super(name,age);
        this.salary = salary;
    }

    showSalary() {
        console.log("My salary is " + this.salary);
    }
}
const studObj = new Student("John",15,400);
studObj.intro();
studObj.showTotalMarks();

const empObj = new Employee("Alice",23,10000);
empObj.intro();
empObj.showSalary();


