//map:
//It goes through (traverse) each element.It creates a new array .It does NOT change original array.
let numbers = [1, 2, 3, 4, 5];
numbers.map((item, index) => console.log(item, index));

//Filter: (find even numbers) - Used to get multiple values from an array based on a condition.
let numbers1 = [1, 2, 3, 4, 5];
function evenNumbers() {
    console.log(numbers1.filter((item) => item % 2 === 0));// you can give any name instead of "item"

}
evenNumbers();

//find - Used to get only the first matching value
let numbers2 = [1, 2, 3, 4, 5];
let result = numbers2.find((item) => item % 2 === 0);
console.log(result);

//Reduce - combine all values into one value(sum of values).
let numbers3 = [1, 2, 3, 4, 5];
function addNumbers() {
    //accumulator - add value one by one (add value from 0)
    console.log(numbers3.reduce((accumulator, item) => accumulator + item, 0));// initialize accumulator = 0

}
addNumbers();

