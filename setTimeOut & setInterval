//setTimeOut & setInterval

//setTimeout is the simulation for asynchronus programming
//syntax - setTimeout(function, time in milliseconds)
setTimeout(() => {
    console.log("Hello World");
},3000)//3000 millisecond = 3 second


console.log("Innings Before Strategic Timeout");
setTimeout(() => {
    console.log("Game Resuming After 3 Seconds");
},3000)//3000 millisecond = 3 second
console.log("Innings After Strategic Timeout");

