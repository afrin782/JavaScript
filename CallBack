//2 numbers should be added and the result must be multiplied with 5
function Add(a,b,callback) {
    let result = a+b;
    callback(result);
}
//here, multiply is the callback
function Multiply(result) {
    console.log(result * 5);
}

Add(1,2,Multiply);
